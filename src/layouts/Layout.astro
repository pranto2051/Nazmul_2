---
import { ClientRouter } from 'astro:transitions';
import Ambient from '@/components/Ambient.astro';
import Refraction from '@/components/Refraction.astro';
import Header from '@/components/Header';
import Footer from '@/components/Footer.astro';
import { site } from '@/content/site';
import { IMG } from '@/content/images';
import '@/styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: string;
  canonical?: string;
}

const {
  title = 'Nazmul Hasan Shouvo — AI & Medical Imaging Researcher',
  description = site.description,
  image = IMG.ogImage,
  type = 'website',
  canonical = Astro.url.href,
} = Astro.props;

const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#071319" />
    <link rel="icon" href="/favicon.ico" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:url" content={canonical} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Newsreader:opsz,wght@6..72,400;6..72,600&family=Space+Grotesk:wght@400;500;600;700&display=swap"
    />

    <!-- Astro ClientRouter for SPA Navigation without full page reload -->
    <ClientRouter />

    <!-- Theme Initialization & Transition Persistence Script -->
    <script is:inline>
      function applyTheme() {
        try {
          var t = localStorage.getItem('theme');
          if (t === 'dark' || (!t && matchMedia('(prefers-color-scheme:dark)').matches)) {
            document.documentElement.classList.add('dark');
          } else {
            document.documentElement.classList.remove('dark');
          }
        } catch (e) {}
      }

      applyTheme();
      document.addEventListener('astro:after-swap', applyTheme);
    </script>
  </head>
  <body>
    <div transition:persist="ambient-background">
      <Ambient />
    </div>

    <div transition:persist="refraction-filter">
      <Refraction />
    </div>

    <Header client:load currentPath={currentPath} transition:persist="site-header" />

    <slot />

    <Footer transition:persist="site-footer" />

    <!-- Interactive Glass Mouse Highlight Script -->
    <script is:inline>
      function setupPointerMove() {
        document.addEventListener('pointermove', function (e) {
          var target = e.target.closest('.interactive-glass');
          if (target) {
            var rect = target.getBoundingClientRect();
            target.style.setProperty('--mx', (e.clientX - rect.left) + 'px');
            target.style.setProperty('--my', (e.clientY - rect.top) + 'px');
          }
        });
      }
      setupPointerMove();
      document.addEventListener('astro:page-load', setupPointerMove);
    </script>
  </body>
</html>
