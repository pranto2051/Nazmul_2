---
import Layout from '@/layouts/Layout.astro';
import GalleryGrid from '@/components/GalleryGrid';
import { gallery } from '@/content/gallery';
---

<Layout
  title="Research Gallery — Nazmul Hasan Shouvo"
  description="Architecture, results, XAI, segmentation, events, and certificates."
>
  <main class="page-shell">
    <header class="page-heading">
      <span class="kicker">Visual Artifacts</span>
      <h1>Gallery</h1>
      <p>Research figures, model views, teaching moments, and credentials in one visual record.</p>
    </header>

    <GalleryGrid client:load initialFigures={gallery} />
  </main>
</Layout>
