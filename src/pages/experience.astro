---
import Layout from '@/layouts/Layout.astro';
import ExperienceFilter from '@/components/ExperienceFilter';
import { experience } from '@/content/experience';
---

<Layout
  title="Experience — Nazmul Hasan Shouvo"
  description="Research, teaching, mentorship, and professional experience."
>
  <main class="page-shell">
    <header class="page-heading">
      <span class="kicker">Trajectory</span>
      <h1>Experience</h1>
      <p>Research, teaching, mentorship, and technical practice in one chronological record.</p>
    </header>

    <ExperienceFilter client:load items={experience} />
  </main>
</Layout>
